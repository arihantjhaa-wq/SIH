# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.fhrokfb.mongodb.net/kheti_seedha

# Server Port
PORT=7200

# Environment Mode
NODE_ENV=development

# JWT Secrets & Expiry
ACCESS_TOKEN_SECRET=your_access_token_secret_here
