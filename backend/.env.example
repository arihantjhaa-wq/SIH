# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/kheti_seedha

# Server Port
PORT=7200

# Environment Mode
NODE_ENV=development

# JWT Secrets & Expiry
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=10d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=1d

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Developer Access (for development/demo convenience only - DISABLE IN PRODUCTION)
DEVELOPER_ACCESS_ENABLED=true
DEVELOPER_ACCESS_KEY=your_developer_access_key_here

# Image Upload Configuration
UPLOAD_DIR=./public/uploads/products
PUBLIC_BASE_URL=http://localhost:7200

GST_VERIFICATION_ENABLED=true

# Transportation Service (port 8001)
TRANSPORTATION_SERVICE_URL=http://localhost:8001

# Price Forecaster Service (port 8002)
PRICE_FORECASTER_SERVICE_URL=http://localhost:8002

# Cloudinary Configuration (get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
