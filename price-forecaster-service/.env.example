# Price Forecaster Service Environment Variables
# Copy to .env and replace with actual values

# Service Configuration
PORT=8002
DEBUG=false

# External APIs
GOOGLE_MAPS_API_KEY=AIzaSy...  # Your Google Maps API key (optional)
# No API key needed for Open-Meteo (free)

# Dataset
DATASET_FILE=india_agricultural_prices_last_5_days_june_september_2026.json

# Timezone (India)
TIMEZONE=Asia/Kolkata
